generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Network {
  MTN
  GLO
  AIRTEL
  NINE_MOBILE
}

enum WalletTxType {
  FUNDING
  DEBIT
  CREDIT
  REFUND
}

enum WalletTxStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PinStatus {
  AVAILABLE
  SOLD
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  UNKNOWN
}

enum DataSubscriptionStatus {
  PENDING
  COMPLETED
  FAILED
  UNKNOWN
}

enum ProviderOutcome {
  SUCCESS
  REJECTED
  PENDING
  UNKNOWN
}

enum ProviderRetryability {
  RETRYABLE
  NOT_RETRYABLE
  UNKNOWN
}

enum ConversionType {
  AIRTIME
  DATA
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CREDITED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  fullName      String
  businessName  String?
  passwordHash  String
  role          Role      @default(VENDOR)
  status        UserStatus @default(ACTIVE)

  wallet                Wallet?
  purchases             PinPurchase[]
  batchesCreated        PinBatch[]        @relation("CreatedBatches")
  airtimePurchases      AirtimePurchase[]
  dataSubscriptions     DataSubscription[]
  conversionRequests          ConversionRequest[] @relation("ConversionRequestVendor")
  verifiedConversionRequests  ConversionRequest[] @relation("ConversionRequestVerifier")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  transactions  WalletTransaction[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id            String         @id @default(uuid())
  walletId      String
  wallet        Wallet         @relation(fields: [walletId], references: [id])
  type          WalletTxType
  amount        Decimal        @db.Decimal(14, 2)
  balanceBefore Decimal        @db.Decimal(14, 2)
  balanceAfter  Decimal        @db.Decimal(14, 2)
  reference     String         @unique
  status        WalletTxStatus @default(PENDING)
  description   String?
  provider            String?
  providerReference  String?
  providerStatus     String?
  providerOutcome    ProviderOutcome?
  providerRetryability ProviderRetryability?
  providerResponse   Json?
  paidAt        DateTime?
  creditedAt    DateTime?
  conversionRequest ConversionRequest?

  createdAt     DateTime       @default(now())

  @@index([provider, providerReference])
  @@map("wallet_transactions")
}

model ConversionConfig {
  id             String         @id @default(uuid())
  type           ConversionType @unique
  rate           Decimal        @db.Decimal(5, 2)
  minimumAmount  Decimal        @db.Decimal(14, 2)
  maximumAmount  Decimal?       @db.Decimal(14, 2)
  isActive       Boolean        @default(true)

  requests       ConversionRequest[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("conversion_configs")
}

model ConversionRequest {
  id                  String           @id @default(uuid())
  userId              String
  user                User             @relation("ConversionRequestVendor", fields: [userId], references: [id])
  verifiedById         String?
  verifiedBy           User?            @relation("ConversionRequestVerifier", fields: [verifiedById], references: [id])
  configId            String
  config              ConversionConfig @relation(fields: [configId], references: [id])
  walletTransactionId String?          @unique
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])

  type                ConversionType
  amount              Decimal          @db.Decimal(14, 2)
  rate               Decimal          @db.Decimal(5, 2)
  convertedAmount     Decimal          @db.Decimal(14, 2)
  reference           String           @unique
  status              ConversionStatus @default(PENDING)
  sourcePhone         String?
  sourceReference     String?
  rejectionReason     String?
  verificationNote    String?
  verifiedAt          DateTime?
  processedAt         DateTime?

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([userId, status])
  @@map("conversion_requests")
}

model PinBatch {
  id                String        @id @default(uuid())
  batchLabel        String        @unique
  network           Network
  denomination      Decimal       @db.Decimal(10, 2)
  costPrice         Decimal       @db.Decimal(10, 2)
  sellingPrice      Decimal       @db.Decimal(10, 2)
  totalQuantity     Int
  availableQuantity Int

  createdById       String
  createdBy         User          @relation("CreatedBatches", fields: [createdById], references: [id])

  pins              RechargePin[]
  purchases         PinPurchase[]

  createdAt         DateTime      @default(now())

  @@map("pin_batches")
}

model RechargePin {
  id           String       @id @default(uuid())
  batchId      String
  batch        PinBatch     @relation(fields: [batchId], references: [id])
  serialNumber String       @unique
  pinCode      String
  status       PinStatus    @default(AVAILABLE)

  purchaseId   String?
  purchase     PinPurchase? @relation(fields: [purchaseId], references: [id])
  soldAt       DateTime?

  createdAt    DateTime     @default(now())

  @@index([batchId, status])
  @@map("recharge_pins")
}

model AirtimePurchase {
  id        String         @id @default(uuid())
  vendorId  String
  vendor    User           @relation(fields: [vendorId], references: [id])
  network   Network
  phone     String
  amount    Decimal        @db.Decimal(14, 2)
  reference String         @unique
  status    PurchaseStatus @default(PENDING)

  provider             String?
  providerReference    String?
  providerStatus       String?
  providerOutcome      ProviderOutcome?
  providerRetryability ProviderRetryability?
  providerResponse     Json?
  paidAt               DateTime?

  createdAt DateTime       @default(now())

  @@map("airtime_purchases")
}

model DataSubscription {
  id            String                  @id @default(uuid())
  vendorId      String
  vendor        User                    @relation(fields: [vendorId], references: [id])
  network       Network
  phone         String
  plan          String
  amount        Decimal                 @db.Decimal(14, 2)
  reference     String                  @unique
  status        DataSubscriptionStatus  @default(PENDING)
  provider      String?
  providerReference String?
  providerStatus String?
  providerOutcome ProviderOutcome?
  providerRetryability ProviderRetryability?
  providerResponse  Json?
  paidAt        DateTime?

  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("data_subscriptions")
}

model PinPurchase {
  id           String         @id @default(uuid())
  vendorId     String
  vendor       User           @relation(fields: [vendorId], references: [id])
  batchId      String
  batch        PinBatch       @relation(fields: [batchId], references: [id])

  network      Network
  denomination Decimal        @db.Decimal(10, 2)
  quantity     Int
  unitPrice    Decimal        @db.Decimal(10, 2)
  unitCost     Decimal        @db.Decimal(10, 2)
  totalAmount  Decimal        @db.Decimal(14, 2)
  totalProfit  Decimal        @db.Decimal(14, 2)

  reference    String         @unique
  status       PurchaseStatus @default(COMPLETED)

  pins         RechargePin[]

  createdAt    DateTime       @default(now())

  @@map("pin_purchases")
}
