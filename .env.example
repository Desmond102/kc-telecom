# KC TELECOM example environment

# Database (Postgres)
DATABASE_URL=postgresql://user:pass@localhost:5432/kc_telecom?schema=public

# App
PORT=3000
JWT_SECRET=change-me

# Paystack (existing)
PAYSTACK_SECRET_KEY=changeme
PAYSTACK_CALLBACK_URL=http://localhost:5173/vendor/wallet

# VTU (Airtime provider) - placeholders only (do NOT put real secrets here)
# Select the provider name used by the app (e.g. HTTP). The app ships with a
# generic HTTP provider implementation that reads the base URL and API key.
VTU_PROVIDER_NAME=HTTP
VTU_BASE_URL=https://example-vtu-provider.local
VTU_API_KEY=change-me
VTU_TIMEOUT_MS=10000

# Provider selection: HTTP, PAIRGATE or SUBANDGAIN
# Keep the app on the generic HTTP provider unless a specific VTU backend is configured.
AIRTIME_DATA_PROVIDER=HTTP
VTU_PROVIDER_NAME=HTTP

# Pairgate Airtime/Data (optional; leave AIRTIME_DATA_PROVIDER=HTTP to keep the generic provider)
PAIRGATE_BASE_URL=
PAIRGATE_API_KEY=
PAIRGATE_TIMEOUT_MS=10000
PAIRGATE_DATA_PLAN_MAP=
PAIRGATE_WEBHOOK_SECRET=

# SubAndGain Airtime/Data (server-side only; never expose to frontend)
SUBANDGAIN_USERNAME=
SUBANDGAIN_API_KEY=
SUBANDGAIN_BASE_URL=https://example-subandgain.local
SUBANDGAIN_TIMEOUT_MS=10000
